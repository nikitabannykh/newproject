# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Запуск с файлом (Node 20+): node --env-file=.env server.mjs

# 2ГИС Places API 3.0 — https://dev.2gis.ru (демо-ключ: 10 организаций на страницу, до 5 страниц)
TWOGIS_KEY=

# Yandex Search API — поиск сайтов компаний (только локально; в проде переменные живут в функции Yandex Cloud)
SEARCH_API_KEY=
FOLDER_ID=

# Прод (Vercel): адрес функции-краулера в Yandex Cloud и общий секрет с ней
YC_ENRICH_URL=
YC_ENRICH_TOKEN=

# Необязательно: хосты, которым разрешено вызывать API (через запятую)
# ALLOWED_HOSTS=example.vercel.app,localhost:8787

PORT=8787
